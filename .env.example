# Copy to .env.local. Everything is optional for local play:
# with nothing set, games live in memory and use the built-in question packs.

# --- AI (Vercel AI Gateway) -------------------------------------------------
# Writes a fresh survey every game, judges fuzzy answers, and voices the host.
# Create a key at https://vercel.com/d?to=/[team]/~/ai/api-keys
# On Vercel, deployments authenticate automatically via OIDC — no key needed.
AI_GATEWAY_API_KEY=

# Optional model overrides (any "provider/model" the gateway supports)
# AI_MODEL=openai/gpt-6.1-sol      # writes the survey (with medium reasoning)
# AI_FAST_MODEL=anthropic/claude-haiku-5.5
# Decision model that judges whether a guess matches a board answer
# AI_JUDGE_MODEL=typesafe-ai/jev
# Host voice (text-to-speech). Falls back to the browser's voice if unavailable.
# AI_TTS_MODEL=fish-audio/drama-3
# AI_TTS_VOICE=            # optional provider voice id for every pack
# AI_TTS_VOICE_HARRY_POTTER=   # ...or per pack: AI_TTS_VOICE_<PACK_ID>
#   (the Fish Audio voice id is the last part of a fish.audio/m/<id> link)

# --- Supabase (database + realtime) -----------------------------------------
# Needed to deploy. The Vercel Marketplace Supabase integration sets these for you.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy anon) key — safe to expose
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy service_role) key — server only!
SUPABASE_SECRET_KEY=
# Postgres connection string (Supabase → Connect → Session pooler). Only used to
# apply supabase/migrations at build time / via `pnpm db:migrate`.
POSTGRES_URL_NON_POOLING=

# --- Seat tokens -------------------------------------------------------------
# Signs the host/player tokens. Falls back to the Supabase secret key if unset.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
